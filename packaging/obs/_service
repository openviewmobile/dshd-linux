<services>
  <!--
    openSUSE OBS source service.

    This is a BINARY REPACKAGE: the service downloads the unsigned Fedora-style
    RPMs produced by electron-builder and the spec unpacks them with
    rpm2cpio/cpio, then installs the payload under /opt/deepseek-harness with
    OBS-owned wrapper/desktop files.  There is no compilation.

    Pin both architectures so `osc service run` / OBS workers fetch exactly the
    reviewed artifacts.  Update the version, filenames and checksums together
    with deepseek-harness.spec.
  -->
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">/openviewmobile/dshd-linux/releases/download/v0.2.2-rc.1.5/deepseek-harness-0.2.2-rc.1.5-linux-x86_64-unsigned.rpm</param>
    <param name="filename">deepseek-harness-0.2.2-rc.1.5-linux-x86_64-unsigned.rpm</param>
  </service>
  <service name="verify_file">
    <param name="file">deepseek-harness-0.2.2-rc.1.5-linux-x86_64-unsigned.rpm</param>
    <param name="verifier">sha256</param>
    <param name="checksum">abcefc34ee819e9085c9c7ddc9d5b31460827ed510271179a231d3da55415718</param>
  </service>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">/openviewmobile/dshd-linux/releases/download/v0.2.2-rc.1.5/deepseek-harness-0.2.2-rc.1.5-linux-aarch64-unsigned.rpm</param>
    <param name="filename">deepseek-harness-0.2.2-rc.1.5-linux-aarch64-unsigned.rpm</param>
  </service>
  <service name="verify_file">
    <param name="file">deepseek-harness-0.2.2-rc.1.5-linux-aarch64-unsigned.rpm</param>
    <param name="verifier">sha256</param>
    <param name="checksum">c9ea6612073b1907c52784c239ef6accd18bf324ad6e01004aa48007150b7ba5</param>
  </service>
</services>
