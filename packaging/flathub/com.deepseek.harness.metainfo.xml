<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.deepseek.harness</id>
  <name>DSHD</name>
  <summary>Linux desktop packaging for DeepSeek Harness</summary>
  <summary xml:lang="zh-CN">DeepSeek Harness 的 Linux 桌面发行版</summary>
  <developer id="com.deepseek.harness">
    <name>OpenView Mobile</name>
  </developer>
  <project_license>MIT</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <description>
    <p>DSHD packages DeepSeek Harness Desktop for Linux with AppImage, deb, rpm and Flatpak output, signed releases, SBOM and build provenance.</p>
    <p>It is an independent downstream packaging project, not an official DeepSeek release.</p>
    <ul>
      <li>Local-first desktop workspace with real providers</li>
      <li>AppImage, deb, rpm and Flatpak packages</li>
      <li>x86_64 and aarch64 release assets</li>
      <li>APT and DNF repositories for x86_64</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.deepseek.harness.desktop</launchable>
  <provides>
    <binary>deepseek-harness</binary>
  </provides>
  <url type="homepage">https://github.com/openviewmobile/dshd-linux</url>
  <url type="bugtracker">https://github.com/openviewmobile/dshd-linux/issues</url>
  <url type="vcs-browser">https://github.com/openviewmobile/dshd-linux</url>
  <url type="help">https://github.com/openviewmobile/dshd-linux/blob/main/docs/README.md</url>
  <categories>
    <category>Development</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>DeepSeek</keyword>
    <keyword>DeepSeek Harness</keyword>
    <keyword>AI</keyword>
    <keyword>desktop</keyword>
    <keyword>Electron</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
